@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="row">
        <!-- Left Side: Form -->
        <div class="col-md-4">
            <h2>Add New Class</h2>
            <form method="post">
                <div class="mb-3">
                    <label for="ClassName" class="form-label">Class Name</label>
                    <input type="text" class="form-control" asp-for="NewClass.ClassName">
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="StudentCount" class="form-label">Student Count</label>
                    <input type="number" class="form-control" asp-for="NewClass.StudentCount">
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" asp-page-handler="Add">Add Class</button>
            </form>
        </div>

        <!-- Right Side: Table -->
        <div class="col-md-8">
            <h2>Class List</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id">
                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>