@page
@model week5.Pages.Classes.IndexModel
@{
    ViewData["Title"] = "Class List";
}

<h2>Class List</h2>

<a href="@Url.Page("./Create")" class="btn btn-success mb-3">Create New Class</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Person Count</th>
            <th>Description</th>
            <th>Is Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var classItem in Model.Classes)
        {
            <tr>
                <td>@classItem.Name</td>
                <td>@classItem.PersonCount</td>
                <td>@classItem.Description</td>
                <td>@classItem.IsActive</td>
                <td>
                    <a href="@Url.Page("./Details", new { id = classItem.Id })" class="btn btn-primary">Details</a> |
                    <a href="@Url.Page("./Edit", new { id = classItem.Id })" class="btn btn-primary">Edit</a> |
                    <a href="@Url.Page("./Delete", new { id = classItem.Id })" class="btn btn-primary">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>